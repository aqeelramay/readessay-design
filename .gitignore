# ==============================================================================
# ReadEssay Monorepo - Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
build/
out/
.next/
*.tsbuildinfo

# Environment & Secret Configuration
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local
.env.*.local

# Explicitly allow committing template/example files
!.env.example
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# IDE & OS Files
.DS_Store
Thumbs.db
.idea/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Temporary files
*.tmp
*.temp
.temp/
.tmp/
