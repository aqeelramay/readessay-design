# API Base URL (including global prefix)
# Local development default:
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Frontend Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production examples:
# NEXT_PUBLIC_API_BASE_URL=https://api.readessay.com/api/v1
# NEXT_PUBLIC_API_URL=https://api.readessay.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://readessay.com
